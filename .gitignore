node_modules/
*.tsbuildinfo
*.tgz

# VS Code extension packages
*.vsix

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables and secrets
.env
.env.*
!.env.example
*.pfx
*.p12

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
